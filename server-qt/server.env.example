# 列出服务端运行所需数据库、监听地址、端口和腾讯地图密钥环境变量示例。

SERVER_HOST=127.0.0.1
SERVER_PORT=9000
DASHBOARD_PORT=9001
DATABASE_PATH=/var/lib/map-for-ecar/charger.db
TENCENT_MAP_KEY=

# Hadoop pipeline --output 的绝对路径；不配置时大屏明确回退到 Qt 汇总。
ANALYTICS_RESULT_PATH=/var/lib/map-for-ecar/dashboard.json
ANALYTICS_MAX_AGE_SECONDS=900
