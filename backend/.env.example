APP_ENV=development
DATABASE_URL=sqlite:///./runtime/map_for_ecar_charger.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
INTERNAL_KEY=replace-with-a-random-internal-key-at-least-32-bytes
TENCENT_MAP_KEY=replace-with-your-tencent-map-webservice-key
TENCENT_MAP_TIMEOUT_SECONDS=5
CORS_ORIGINS=*
USER_TOKEN_EXPIRE_SECONDS=86400
ADMIN_TOKEN_EXPIRE_SECONDS=28800
RESERVATION_TIMEOUT_SECONDS=900
