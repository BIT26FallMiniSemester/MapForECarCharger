{
  "overview_fields": {
    "user_count": 100,
    "total_energy_wh": 12860000
  },
  "stations_map": {
    "method": "GET",
    "path": "/api/v1/dashboard/stations-map",
    "response_item_fields": [
      "station_id",
      "station_name",
      "latitude",
      "longitude",
      "total_piles",
      "available_piles",
      "reserved_piles",
      "charging_piles",
      "fault_piles",
      "offline_piles",
      "online_rate",
      "utilization_rate"
    ]
  },
  "hourly_demand": {
    "method": "GET",
    "path": "/api/v1/dashboard/hourly-demand",
    "query": {"days": 30},
    "hours": {"first": 0, "last": 23, "item_count": 24}
  },
  "alerts": {
    "method": "GET",
    "path": "/api/v1/dashboard/alerts",
    "query": {"limit": 20},
    "levels": ["INFO", "WARNING", "ERROR"],
    "types": ["PILE_FAULT", "PILE_OFFLINE", "PILE_RECOVERED"]
  }
}
