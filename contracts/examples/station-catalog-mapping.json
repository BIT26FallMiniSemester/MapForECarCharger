{
  "list_mappings": {
    "method": "GET",
    "path": "/api/v1/internal/stations/catalog-mappings",
    "headers": {
      "X-Internal-Key": "<internal_key>"
    },
    "query": {
      "data_source": "BEIJING_PUBLIC_DATA_OPEN_PLATFORM",
      "page": 1,
      "page_size": 500
    }
  },
  "exact_lookup": {
    "method": "GET",
    "path": "/api/v1/internal/stations/catalog-mappings",
    "headers": {
      "X-Internal-Key": "<internal_key>"
    },
    "query": {
      "data_source": "BEIJING_PUBLIC_DATA_OPEN_PLATFORM",
      "external_id": "<catalog_external_id>"
    }
  },
  "response_item": {
    "station_id": 4,
    "data_source": "BEIJING_PUBLIC_DATA_OPEN_PLATFORM",
    "external_id": "<catalog_external_id>",
    "station_name": "<station_name>"
  },
  "note": "station_id must always come from the current database mapping; never derive it with a fixed offset."
}
